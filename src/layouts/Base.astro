---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string; description?: string; }
const { title = 'Archie', description = 'A personal space.' } = Astro.props;
const p = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? p === '/' : p.startsWith(href);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"/>
  <meta name="description" content={description}/>
  <title>{title} · Archie</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600;1,700&display=swap" rel="stylesheet"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <ClientRouter />
</head>
<body>

  <div class="flowers" id="flowers" transition:persist="archie-flowers"></div>

  <!-- Global music: persists across page navigation (soft nav) so playback never
       stops just because the user moved to a different page. -->
  <div id="musicPersist" transition:persist="archie-music">
    <audio id="audioPlayer"></audio>

    <div class="mini-player" id="miniPlayer" style="display:none">
      <div class="mini-thumb-wrap" id="miniThumbWrap">
        <img class="mini-thumb" id="miniThumb" src="" alt="" style="display:none"/>
        <svg id="miniThumbFallback" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <div class="mini-info">
        <div class="mini-title" id="miniTitle">—</div>
        <div class="mini-artist" id="miniArtist"></div>
      </div>
      <button class="mini-toggle" id="miniToggle" aria-label="Play/Pause">
        <svg id="miniIconPlay" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <svg id="miniIconPause" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>
      <button class="mini-close" id="miniClose" aria-label="Stop">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="mini-progress" id="miniProgress"><div class="mini-progress-fill" id="miniProgressFill"></div></div>
    </div>
  </div>

  <header class="site-header">
    <a href="/" class="nav-logo">Archie<span class="logo-dot">.</span></a>
  </header>

  <main transition:animate="fade"><slot /></main>

  <footer class="site-footer">© {new Date().getFullYear()} IkhwanJe</footer>

  <div class="tab-bar-outer">
    <slot name="above-tabbar" />
    <nav class="tab-bar">
      <a href="/" class={`tab-item${isActive('/') ? ' active' : ''}`} aria-label="Home">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
      <a href="/notes" class={`tab-item${isActive('/notes') ? ' active' : ''}`} aria-label="Journal">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      </a>
      <a href="/gallery" class={`tab-item${isActive('/gallery') ? ' active' : ''}`} aria-label="Gallery">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </a>
      <a href="/music" class={`tab-item${isActive('/music') ? ' active' : ''}`} aria-label="Music">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </a>

      <a href="/guestbook" class={`tab-item${isActive('/guestbook') ? ' active' : ''}`} aria-label="Guestbook">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </a>
      <a href="/about" class={`tab-item${isActive('/about') ? ' active' : ''}`} aria-label="About">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      </a>
      <a href="/admin/login" data-astro-reload class={`tab-item${isActive('/admin') ? ' active' : ''}`} aria-label="Admin">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
    </nav>
  </div>

  <script>
    // Flowers persist across soft navigations (transition:persist), so this only
    // needs to run once — guard against Astro re-running it on the next page.
    document.addEventListener('astro:page-load', () => {
      const w = window as any;
      if (w.__archieFlowersInit) return;
      w.__archieFlowersInit = true;

      // Several distinct silhouettes so the fall doesn't feel like one flower repeated.
      const FLOWER5 = (c1: string, c2: string) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
        <ellipse cx="20" cy="10" rx="4.8" ry="9.2" fill="${c1}" opacity="0.92" transform="rotate(0,20,20)"/>
        <ellipse cx="20" cy="10" rx="4.8" ry="9.2" fill="${c2}" opacity="0.88" transform="rotate(72,20,20)"/>
        <ellipse cx="20" cy="10" rx="4.8" ry="9.2" fill="${c1}" opacity="0.92" transform="rotate(144,20,20)"/>
        <ellipse cx="20" cy="10" rx="4.8" ry="9.2" fill="${c2}" opacity="0.88" transform="rotate(216,20,20)"/>
        <ellipse cx="20" cy="10" rx="4.8" ry="9.2" fill="${c1}" opacity="0.92" transform="rotate(288,20,20)"/>
        <circle cx="20" cy="20" r="5.5" fill="#eef5ff"/>
        <circle cx="20" cy="20" r="3" fill="#fefce8"/>
      </svg>`;

      const SAKURA = (c1: string, c2: string) => {
        const petal = (a: number, c: string) =>
          `<path d="M20 20 C13 15 12 6 20 2 C28 6 27 15 20 20 Z" fill="${c}" opacity="0.9" transform="rotate(${a},20,20)"/>`;
        return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
          ${[0, 72, 144, 216, 288].map((a, i) => petal(a, i % 2 === 0 ? c1 : c2)).join('')}
          <circle cx="20" cy="20" r="3.2" fill="#fff6e9"/>
        </svg>`;
      };

      const FLOWER4 = (c1: string, c2: string) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
        <ellipse cx="20" cy="11" rx="5.4" ry="9.4" fill="${c1}" opacity="0.9" transform="rotate(0,20,20)"/>
        <ellipse cx="20" cy="11" rx="5.4" ry="9.4" fill="${c2}" opacity="0.86" transform="rotate(90,20,20)"/>
        <ellipse cx="20" cy="11" rx="5.4" ry="9.4" fill="${c1}" opacity="0.9" transform="rotate(180,20,20)"/>
        <ellipse cx="20" cy="11" rx="5.4" ry="9.4" fill="${c2}" opacity="0.86" transform="rotate(270,20,20)"/>
        <circle cx="20" cy="20" r="4.1" fill="#fff8ea"/>
      </svg>`;

      const STARLET = (c: string) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
        <path d="M10 0 L12.3 7.7 L20 10 L12.3 12.3 L10 20 L7.7 12.3 L0 10 L7.7 7.7 Z" fill="${c}" opacity="0.75"/>
      </svg>`;

      const LEAF = (c: string) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 30">
        <path d="M10 2 C18 9 18 21 10 28 C2 21 2 9 10 2 Z" fill="${c}" opacity="0.6"/>
        <line x1="10" y1="5" x2="10" y2="25" stroke="rgba(255,255,255,0.45)" stroke-width="0.9"/>
      </svg>`;

      const PETAL = (c: string) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 28">
        <ellipse cx="9" cy="14" rx="6" ry="12" fill="${c}" opacity="0.55"/>
      </svg>`;

      const PALETTES = [
        ['#b8d0f4', '#9abde8'],
        ['#c2d8f6', '#a8c8ec'],
        ['#bdd4f5', '#9ec0ea'],
        ['#f6c9dd', '#f0a8c4'],
        ['#fbdce7', '#f6c2d9'],
        ['#e3d0f7', '#c9a8ec'],
        ['#fff0d9', '#ffe0b0'],
        ['#d9f0e3', '#b7e3c9'],
        ['#ffffff', '#eef2fb'],
      ];

      const SHAPES = [
        { type: 'flower5', weight: 3,   big: true  },
        { type: 'sakura',  weight: 3,   big: true  },
        { type: 'flower4', weight: 2,   big: true  },
        { type: 'petal',   weight: 3,   big: false },
        { type: 'leaf',    weight: 1.6, big: false },
        { type: 'star',    weight: 1.4, big: false },
      ];
      const totalWeight = SHAPES.reduce((s, x) => s + x.weight, 0);

      function pickShape() {
        let r = Math.random() * totalWeight;
        for (const s of SHAPES) { r -= s.weight; if (r <= 0) return s; }
        return SHAPES[0];
      }

      function markup(type: string, pal: string[]) {
        switch (type) {
          case 'sakura':  return SAKURA(pal[0], pal[1]);
          case 'flower4': return FLOWER4(pal[0], pal[1]);
          case 'star':    return STARLET(pal[0]);
          case 'leaf':    return LEAF(pal[0]);
          case 'petal':   return PETAL(pal[0]);
          default:        return FLOWER5(pal[0], pal[1]);
        }
      }

      function sizeFor(type: string, base: number) {
        switch (type) {
          case 'petal': return { w: base * 0.64, h: base };
          case 'leaf':  return { w: base * 0.67, h: base * 1.05 };
          case 'star':  return { w: base * 0.85, h: base * 0.85 };
          default:      return { w: base, h: base };
        }
      }

      const container = document.getElementById('flowers');
      let activeFlowers = 0;
      const MAX_FLOWERS = 55;

      function spawnFlower() {
        if (!container || activeFlowers >= MAX_FLOWERS) return;
        activeFlowers++;

        const shape = pickShape();
        const pal   = PALETTES[Math.floor(Math.random() * PALETTES.length)];
        const base  = shape.big ? 16 + Math.random() * 18 : 8 + Math.random() * 10;
        const { w, h } = sizeFor(shape.type, base);

        const el = document.createElement('div');
        el.className = 'petal';
        const side = Math.random();
        let x: number;
        if (side < 0.55)      x = 58 + Math.random() * 40;
        else if (side < 0.78) x = 1  + Math.random() * 20;
        else                  x = 20 + Math.random() * 36;

        const dur   = 7 + Math.random() * 7;
        const delay = Math.random() * 0.8;
        const dx    = (Math.random() - 0.5) * 90;
        const rot   = Math.random() * 360;

        el.style.cssText = `left:${x}%;top:-55px;width:${w}px;height:${h}px;--dx:${dx}px;--rot:${rot}deg;animation:floatPetal ${dur}s ${delay}s linear forwards`;
        el.innerHTML = markup(shape.type, pal);
        container.appendChild(el);
        setTimeout(() => { el.remove(); activeFlowers--; }, (dur + delay + 0.5) * 1000);
      }

      // Burst on load then steady
      for (let i = 0; i < 30; i++) setTimeout(spawnFlower, i * 100);
      w.__archieFlowerTimer = setInterval(spawnFlower, 420);
    });
  </script>

  <script>
    // Global music controller — lives on the persisted #musicPersist element, so the
    // <audio> node itself is never destroyed by a page transition. It only stops when
    // the user hits pause/stop; navigating elsewhere never interrupts it.
    document.addEventListener('astro:page-load', () => {
      const w = window as any;
      if (w.ArchieMusic) return; // already set up, element persisted from before

      const audio   = document.getElementById('audioPlayer') as HTMLAudioElement;
      const mini    = document.getElementById('miniPlayer') as HTMLElement;
      const mTitle  = document.getElementById('miniTitle') as HTMLElement;
      const mArtist = document.getElementById('miniArtist') as HTMLElement;
      const mFill   = document.getElementById('miniProgressFill') as HTMLElement;
      const mThumb  = document.getElementById('miniThumb') as HTMLImageElement;
      const mThumbFb= document.getElementById('miniThumbFallback') as HTMLElement;
      const mPlay   = document.getElementById('miniIconPlay') as HTMLElement;
      const mPause  = document.getElementById('miniIconPause') as HTMLElement;
      const mToggle = document.getElementById('miniToggle') as HTMLElement;
      const mClose  = document.getElementById('miniClose') as HTMLElement;
      const STATE_KEY = 'archie-music-state';
      const NOW_PLAYING_KEY = 'archie-now-playing';
      const SHUFFLE_KEY = 'archie-music-shuffle';
      const REPEAT_KEY  = 'archie-music-repeat'; // 'off' | 'one' | 'all'

      let currentTrack: any = null;
      let shuffle = false;
      let repeatMode: 'off' | 'one' | 'all' = 'off';
      try { shuffle = localStorage.getItem(SHUFFLE_KEY) === '1'; } catch {}
      try { repeatMode = (localStorage.getItem(REPEAT_KEY) as any) || 'off'; } catch {}

      function saveState() {
        try {
          if (currentTrack) localStorage.setItem(STATE_KEY, JSON.stringify({ track: currentTrack, time: audio.currentTime }));
        } catch {}
      }

      // Broadcast "now playing" so other pages/tabs (e.g. About) can show a live status
      // without polluting the DOM every timeupdate tick — only writes on track/play/pause change.
      function saveNowPlaying() {
        try {
          if (currentTrack && !audio.paused) {
            localStorage.setItem(NOW_PLAYING_KEY, JSON.stringify({ track: currentTrack, at: Date.now() }));
          } else {
            localStorage.removeItem(NOW_PLAYING_KEY);
          }
        } catch {}
      }

      function setShuffle(v: boolean) {
        shuffle = v;
        try { localStorage.setItem(SHUFFLE_KEY, v ? '1' : '0'); } catch {}
        broadcast();
      }

      function setRepeat(mode: 'off' | 'one' | 'all') {
        repeatMode = mode;
        try { localStorage.setItem(REPEAT_KEY, mode); } catch {}
        broadcast();
      }

      function broadcast() {
        document.dispatchEvent(new CustomEvent('archie:music', {
          detail: {
            track: currentTrack,
            isPlaying: !audio.paused && !!audio.src,
            currentTime: audio.currentTime,
            duration: audio.duration,
            shuffle, repeatMode
          }
        }));
      }

      function updateMini() {
        if (!currentTrack) { mini.style.display = 'none'; return; }
        mini.style.display = 'flex';
        mTitle.textContent = currentTrack.title || 'Unknown';
        mArtist.textContent = currentTrack.artist || '';
        const hasCover = currentTrack.thumbnail && (currentTrack.thumbnail.startsWith('http') || currentTrack.thumbnail.startsWith('/'));
        if (hasCover) { mThumb.src = currentTrack.thumbnail; mThumb.style.display = ''; mThumbFb.style.display = 'none'; }
        else { mThumb.style.display = 'none'; mThumbFb.style.display = ''; }
        const playing = !audio.paused && !!audio.src;
        mPlay.style.display  = playing ? 'none' : '';
        mPause.style.display = playing ? '' : 'none';
        mini.classList.toggle('is-playing', playing);
      }

      function playTrack(track: any) {
        if (!track) return;
        if (currentTrack && currentTrack.id === track.id) { toggle(); return; }
        currentTrack = track;
        audio.src = track.url;
        audio.currentTime = 0;
        audio.play().catch(() => {});
        updateMini();
        saveState();
      }

      function toggle() {
        if (!audio.src) return;
        if (audio.paused) audio.play().catch(() => {}); else audio.pause();
      }

      function stop() {
        audio.pause();
        audio.removeAttribute('src');
        audio.load();
        currentTrack = null;
        try { localStorage.removeItem(STATE_KEY); } catch {}
        saveNowPlaying();
        updateMini();
        broadcast();
      }

      let lastNowPlayingWrite = 0;
      audio.addEventListener('play',  () => { updateMini(); saveNowPlaying(); broadcast(); });
      audio.addEventListener('pause', () => { updateMini(); saveState(); saveNowPlaying(); broadcast(); });
      audio.addEventListener('timeupdate', () => {
        if (audio.duration) mFill.style.width = (audio.currentTime / audio.duration * 100) + '%';
        // Refresh the "now playing" heartbeat periodically (not every tick) so
        // the About page's staleness check never expires while a track is
        // genuinely still playing.
        const now = Date.now();
        if (!audio.paused && now - lastNowPlayingWrite > 4000) {
          lastNowPlayingWrite = now;
          saveNowPlaying();
        }
        broadcast();
      });
      audio.addEventListener('loadedmetadata', broadcast);
      audio.addEventListener('ended', () => {
        if (repeatMode === 'one') {
          audio.currentTime = 0;
          audio.play().catch(() => {});
          return;
        }
        document.dispatchEvent(new CustomEvent('archie:music-ended'));
      });

      mToggle.addEventListener('click', toggle);
      mClose.addEventListener('click', stop);

      w.ArchieMusic = {
        playTrack, toggle, stop, audio,
        getCurrent: () => currentTrack,
        getShuffle: () => shuffle,
        getRepeat: () => repeatMode,
        setShuffle, setRepeat,
      };

      // Restore last track after a hard refresh (autoplay stays blocked by the
      // browser until the user presses play again — that's expected).
      try {
        const raw = localStorage.getItem(STATE_KEY);
        if (raw && !audio.src) {
          const saved = JSON.parse(raw);
          if (saved?.track?.url) {
            currentTrack = saved.track;
            audio.src = saved.track.url;
            audio.currentTime = saved.time || 0;
            updateMini();
          }
        }
      } catch {}
    });
  </script>
</body>
</html>

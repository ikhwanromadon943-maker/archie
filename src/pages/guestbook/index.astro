---
import Base from '../../layouts/Base.astro';
---
<Base title="Guestbook" description="Leave a message. Say hello.">

  <header class="notes-hdr">
    <h1>Guestbook</h1>
    <p>Leave a message, a memory, or just say hello. Everyone can read and reply.</p>
  </header>

  <div class="loading-state" id="loading"><span class="loader"></span></div>

  <div class="gb-feed-wrap">
    <div class="gb-feed" id="gb-feed"></div>
  </div>

  <div class="empty-state" id="empty-state" style="display:none">
    <div class="empty-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    </div>
    <h3>No messages yet.</h3>
    <p>Be the first to sign the guestbook.</p>
  </div>

  <div class="gb-composer-error" id="gb-error" slot="above-tabbar"></div>

  <!-- Rendered inside the layout's tab-bar-outer (see slot="above-tabbar"),
       so it shares the exact same fixed-position anchor as the tab bar
       itself — no separate bottom: Npx guess that can drift on different
       browsers/viewports (in-app browsers like Instagram's included). -->
  <div class="gb-composer" slot="above-tabbar">
    <input type="text" id="gb-name" class="gb-composer-name" placeholder="Name" maxlength="60" autocomplete="off"/>
    <input type="text" id="gb-message" class="gb-composer-msg" placeholder="Add a comment..." maxlength="500" autocomplete="off"/>
    <button class="gb-composer-send" id="gb-submit" aria-label="Post">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>

</Base>

<script>
  import { supabase } from '../../lib/supabase';

  document.addEventListener('astro:page-load', () => {

  // Push the global mini-player up above this page's composer, since the
  // composer now lives inside the same fixed tab-bar-outer stack (see
  // Base.astro slot="above-tabbar") and would otherwise overlap it.
  const composerEl = document.querySelector('.gb-composer') as HTMLElement;
  function syncComposerHeight() {
    if (composerEl) {
      document.documentElement.style.setProperty('--composer-h', composerEl.offsetHeight + 8 + 'px');
    }
  }
  syncComposerHeight();
  window.addEventListener('resize', syncComposerHeight);

  const NAME_KEY  = 'guestbook_name';
  const LIKE_KEY  = 'liked_guestbook_v1';
  // Maps message id -> the secret owner_token returned by post_guestbook_entry
  // at the moment *this browser* posted it. That token is required server-side
  // (see delete_guestbook_entry RPC) to delete a non-admin message — nobody
  // else can produce it, since it's never included in public reads.
  const OWNED_KEY = 'guestbook_owned_tokens_v1';

  const getLiked = (): Set<string> => {
    try { return new Set(JSON.parse(localStorage.getItem(LIKE_KEY) || '[]')); }
    catch { return new Set(); }
  };
  const saveLiked = (s: Set<string>) => localStorage.setItem(LIKE_KEY, JSON.stringify([...s]));

  const getOwnedTokens = (): Record<string, string> => {
    try { return JSON.parse(localStorage.getItem(OWNED_KEY) || '{}'); }
    catch { return {}; }
  };
  const saveOwnedToken = (id: string, token: string) => {
    const m = getOwnedTokens(); m[id] = token;
    localStorage.setItem(OWNED_KEY, JSON.stringify(m));
  };
  const removeOwnedToken = (id: string) => {
    const m = getOwnedTokens(); delete m[id];
    localStorage.setItem(OWNED_KEY, JSON.stringify(m));
  };

  const fdate = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const esc = (s: string) => (s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] as string));

  const nameInput = document.getElementById('gb-name') as HTMLInputElement;
  const msgInput  = document.getElementById('gb-message') as HTMLInputElement;
  const errorEl   = document.getElementById('gb-error') as HTMLElement;
  const submitBtn = document.getElementById('gb-submit') as HTMLButtonElement;
  const feed      = document.getElementById('gb-feed') as HTMLElement;
  const loading   = document.getElementById('loading') as HTMLElement;
  const empty     = document.getElementById('empty-state') as HTMLElement;

  const savedName = localStorage.getItem(NAME_KEY);
  if (savedName) nameInput.value = savedName;

  let allEntries: any[] = [];
  let replyTarget: { id: string; name: string } | null = null;

  function isAdminSession() { return sessionStorage.getItem('admin_authed') === '1'; }

  function setReplyTarget(id: string | null, name?: string) {
    replyTarget = id ? { id, name: name || '' } : null;
    msgInput.placeholder = replyTarget ? `Replying to ${replyTarget.name}...` : 'Add a comment...';
    if (replyTarget) msgInput.focus();
  }

  async function deleteEntry(entry: any) {
    if (!confirm('Delete this message?')) return;
    const adminPass = isAdminSession() ? (sessionStorage.getItem('admin_pass') || '') : null;
    const ownedTokens = getOwnedTokens();
    const ownerToken = ownedTokens[entry.id] || null;

    if (!adminPass && !ownerToken) return; // no permission we can prove — button shouldn't even be visible

    const { data: ok, error } = await supabase.rpc('delete_guestbook_entry', {
      p_id: entry.id,
      p_owner_token: adminPass ? null : ownerToken,
      p_admin_pass: adminPass
    });

    if (error || !ok) { alert('Could not delete this message.'); return; }
    removeOwnedToken(entry.id);
    render();
  }

  function buildEntry(entry: any, isReply: boolean): HTMLElement {
    const liked = getLiked();
    const isLiked = liked.has(entry.id);
    const owned = getOwnedTokens();
    const canDelete = isAdminSession() || !!owned[entry.id];

    const el = document.createElement('div');
    el.className = 'gb-entry' + (isReply ? ' gb-entry-reply' : '') + (entry.is_admin ? ' gb-entry-admin' : '');

    el.innerHTML = `
      <div class="gb-entry-avatar">${esc(entry.name).charAt(0).toUpperCase() || '?'}</div>
      <div class="gb-entry-body">
        <div class="gb-entry-head">
          <span class="gb-entry-name">${esc(entry.name)}${entry.is_admin ? '<span class="gb-admin-badge">Archie</span>' : ''}</span>
          <span class="gb-entry-date">${fdate(entry.created_at)}</span>
        </div>
        <p class="gb-entry-msg">${esc(entry.message).replace(/\n/g,'<br>')}</p>
        <div class="gb-entry-actions">
          <button class="gb-reply-btn">Reply</button>
          ${canDelete ? '<button class="gb-delete-btn">Delete</button>' : ''}
        </div>
      </div>
      <button class="gb-like-btn${isLiked ? ' liked' : ''}" data-id="${entry.id}" data-liked="${isLiked}" aria-label="Like">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="${isLiked ? '#ef4444' : 'none'}" stroke="${isLiked ? '#ef4444' : 'currentColor'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="lc">${entry.likes ?? 0}</span>
      </button>
    `;

    // Like — always toggles red/filled the same way, on every entry and reply alike.
    el.querySelector<HTMLButtonElement>('.gb-like-btn')!.addEventListener('click', async function () {
      const id = this.dataset.id!;
      const wasLiked = this.dataset.liked === 'true';
      const likedSet = getLiked();
      const lc = this.querySelector('.lc')!;
      const svg = this.querySelector('svg')!;
      const cur = parseInt(lc.textContent || '0');

      if (wasLiked) {
        likedSet.delete(id); this.dataset.liked = 'false'; this.classList.remove('liked');
        svg.setAttribute('fill', 'none'); svg.setAttribute('stroke', 'currentColor');
        lc.textContent = String(Math.max(0, cur - 1));
        await supabase.rpc('decrement_likes', { table_name: 'guestbook', row_id: id });
      } else {
        likedSet.add(id); this.dataset.liked = 'true'; this.classList.add('liked');
        svg.setAttribute('fill', '#ef4444'); svg.setAttribute('stroke', '#ef4444');
        lc.textContent = String(cur + 1);
        await supabase.rpc('increment_likes', { table_name: 'guestbook', row_id: id });
      }
      saveLiked(likedSet);
    });

    el.querySelector('.gb-reply-btn')!.addEventListener('click', () => {
      setReplyTarget(isReply ? (entry.parent_id || entry.id) : entry.id, entry.name);
    });

    const delBtn = el.querySelector('.gb-delete-btn');
    delBtn?.addEventListener('click', () => deleteEntry(entry));

    return el;
  }

  async function render() {
    // guestbook_public omits owner_token — nobody but the original poster's
    // own browser ever sees the token needed to delete a message.
    const { data, error } = await supabase
      .from('guestbook_public').select('*').order('created_at', { ascending: false });

    loading.style.display = 'none';
    if (error) { feed.innerHTML = `<p class="err-msg">[error] ${error.message}</p>`; return; }

    allEntries = data || [];
    feed.innerHTML = '';

    const roots = allEntries.filter(e => !e.parent_id);
    if (!roots.length) { empty.style.display = 'block'; return; }
    empty.style.display = 'none';

    roots.forEach((root, i) => {
      const wrap = document.createElement('div');
      wrap.className = 'gb-thread';
      wrap.style.cssText = `opacity:0;animation:fadeUp 0.35s ease ${Math.min(i * 0.05, 0.4)}s forwards`;
      wrap.appendChild(buildEntry(root, false));

      const replies = allEntries.filter(e => e.parent_id === root.id).sort((a,b) => a.created_at.localeCompare(b.created_at));
      if (replies.length) {
        const repliesWrap = document.createElement('div');
        repliesWrap.className = 'gb-replies';
        replies.forEach(r => repliesWrap.appendChild(buildEntry(r, true)));
        wrap.appendChild(repliesWrap);
      }

      feed.appendChild(wrap);
    });
  }

  async function submit() {
    const name = nameInput.value.trim() || 'Anonymous';
    const message = msgInput.value.trim();
    errorEl.textContent = '';

    if (!message) { errorEl.textContent = 'Write something first.'; return; }

    localStorage.setItem(NAME_KEY, name);
    submitBtn.disabled = true;

    const isAdmin = isAdminSession();
    const { data, error } = await supabase.rpc('post_guestbook_entry', {
      p_name: isAdmin ? 'Archie' : name,
      p_message: message,
      p_parent_id: replyTarget?.id || null,
      p_is_admin: isAdmin
    });

    submitBtn.disabled = false;
    if (error) { errorEl.textContent = error.message; return; }

    const row = Array.isArray(data) ? data[0] : data;
    if (row?.id && row?.owner_token) saveOwnedToken(row.id, row.owner_token);

    msgInput.value = '';
    setReplyTarget(null);
    render();
  }

  submitBtn.addEventListener('click', submit);
  msgInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });

  render();
  });
</script>

<!-- is:global WAJIB karena class di-inject via JS, Astro scoped CSS tidak akan apply -->
<style is:global>
  .gb-feed-wrap {
    /* Independent scroll area for messages — no matter how many pile up,
       the composer below stays fixed and never gets pushed down. */
    max-height: calc(100dvh - 15rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4.5rem; /* clears the mini-player when it's visible above the composer */
  }
  .gb-feed {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1rem;
  }
  .gb-thread {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 0.6rem;
  }

  /* TikTok-style compact row: avatar, name+text, like on the right */
  .gb-entry {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 0.85rem;
    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 18px;
    box-shadow: 0 4px 18px rgba(100,149,237,0.08), inset 0 1px 0 rgba(255,255,255,0.5);
  }
  .gb-entry-avatar {
    width: 34px; height: 34px;
    min-width: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #a8c8f0, #6495ED);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700;
    flex-shrink: 0;
  }
  .gb-entry-admin {
    background: rgba(100,149,237,0.10);
    border-color: rgba(100,149,237,0.35);
  }

  .gb-entry-body { flex: 1; min-width: 0; }
  .gb-entry-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .gb-entry-name {
    font-weight: 600;
    font-size: 0.78rem;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .gb-admin-badge {
    font-size: 0.58rem;
    background: #6495ED;
    color: #fff;
    padding: 1px 6px;
    border-radius: 20px;
    font-weight: 700;
  }
  .gb-entry-date {
    font-size: 0.65rem;
    color: #cbd5e1;
  }
  .gb-entry-msg {
    font-size: 0.88rem;
    color: #1e293b;
    line-height: 1.45;
    margin-top: 0.1rem;
    word-break: break-word;
  }
  .gb-entry-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.3rem;
  }
  .gb-reply-btn, .gb-delete-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.7rem;
    font-weight: 600;
    color: #94a3b8;
    padding: 0;
  }
  .gb-reply-btn:hover { color: #6495ED; }
  .gb-delete-btn { color: #f3a1a1; }
  .gb-delete-btn:hover { color: #ef4444; }

  .gb-like-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: none;
    border: none;
    cursor: pointer;
    color: #cbd5e1;
    padding: 0.15rem 0.2rem 0;
    flex-shrink: 0;
    transition: color 0.15s, transform 0.15s;
  }
  .gb-like-btn:active { transform: scale(0.85); }
  .gb-like-btn.liked { color: #ef4444; }
  .gb-like-btn .lc {
    font-size: 0.62rem;
    font-weight: 600;
    color: #94a3b8;
  }
  .gb-like-btn.liked .lc { color: #ef4444; }

  .gb-replies {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-left: 2.4rem;
    margin-top: 0.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid rgba(100,149,237,0.15);
  }
  .gb-entry-reply { padding: 0.6rem 0.75rem; }
  .gb-entry-reply .gb-entry-avatar { width: 26px; height: 26px; min-width: 26px; font-size: 0.7rem; }
  .gb-entry-reply .gb-entry-msg { font-size: 0.82rem; }

  /* COMPOSER — pinned above mini-player/tab-bar, TikTok-style single compact row */
  .gb-composer {
    /* Lives inside .tab-bar-outer now (slot="above-tabbar"), stacked in the
       same flex column as the nav itself — so it shares one single fixed
       anchor instead of two independently-positioned fixed elements that
       can drift apart on different browser chrome (e.g. in-app browsers). */
    width: 100%;
    max-width: 480px; /* matches .tab-bar's max-width so edges line up */
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(100,149,237,0.25);
    border-radius: 24px;
    padding: 0.5rem 0.5rem 0.5rem 0.9rem;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.06), 0 8px 28px rgba(100,149,237,0.12);
    pointer-events: auto; /* parent .tab-bar-outer sets pointer-events:none */
  }
  .gb-composer-name {
    width: 64px;
    flex-shrink: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.78rem;
    font-weight: 600;
    color: #334155;
    border-right: 1px solid #e2e8f0;
    padding-right: 0.5rem;
  }
  .gb-composer-name::placeholder { color: #cbd5e1; font-weight: 500; }
  .gb-composer-msg {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.85rem;
    color: #1e293b;
  }
  .gb-composer-msg::placeholder { color: #cbd5e1; }
  .gb-composer-send {
    width: 34px; height: 34px;
    min-width: 34px;
    border-radius: 50%;
    border: none;
    background: #6495ED;
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(100,149,237,0.35);
    transition: background 0.15s, transform 0.15s;
  }
  .gb-composer-send:hover { background: #5b89dc; transform: scale(1.05); }
  .gb-composer-send:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .gb-composer-error {
    width: 100%;
    max-width: 480px;
    text-align: center;
    font-size: 0.72rem;
    color: var(--red);
    min-height: 0;
  }
  .gb-composer-error:empty { display: none; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

---
import Base from '../../layouts/Base.astro';
---
<Base title="About" description="The philosophy behind Archie.">

  <div class="about-outer">
    <div class="about-card">
      <div class="about-deco"></div>
      <article class="about-article">

        <section class="about-section">
          <h1 class="about-h1">Archie.</h1>
          <div class="about-body">
            <p>The name is a whisper from the woodlands, taken from <em>Myosotis sylvatica</em>.</p>
            <p>To the world, it is known simply as the <strong>Forget-Me-Not</strong>. A small, unassuming blue flower that carries a weight far heavier than its petals: a plea against oblivion.</p>
          </div>
        </section>

        <div class="about-divider"></div>

        <section class="about-section">
          <h2 class="about-h2">The Philosophy</h2>
          <div class="about-body">
            <p>In the Victorian language of flowers, the Forget-Me-Not symbolizes true love, faithfulness, and <em class="italic-mute">memories that never fade</em>.</p>
            <p>That is the sole purpose of this space.</p>
            <p>It is not a garden to be tended, but a <strong>Sanctuary</strong>. A place to keep the moments that matter, freezing them in digital amber so they are not washed away by time.</p>
          </div>
        </section>

        <div class="about-quote-wrap">
          <blockquote class="about-quote">
            "Silent as the blue flower,<br/>loud as the memory it holds."
          </blockquote>
        </div>

        <div class="now-playing" id="nowPlaying" style="display:none">
          <div class="now-playing-pulse"><span></span><span></span><span></span></div>
          <div class="now-playing-info">
            <div class="now-playing-label">Now playing</div>
            <div class="now-playing-track" id="npTrack"></div>
          </div>
        </div>

      </article>
    </div>
    <div class="enduring-label">ENDURING MEMORIES</div>
  </div>

</Base>

<script>
  // Reads the "now playing" status the global music controller writes to
  // localStorage (see Base.astro). Works across tabs/pages via the storage
  // event, and polls lightly as a fallback within the same tab.
  document.addEventListener('astro:page-load', () => {
    const NOW_PLAYING_KEY = 'archie-now-playing';
    const STALE_MS = 15000; // if not refreshed in 15s, assume playback stopped

    const wrap  = document.getElementById('nowPlaying') as HTMLElement;
    const track = document.getElementById('npTrack') as HTMLElement;
    if (!wrap || !track) return;

    function refresh() {
      try {
        const raw = localStorage.getItem(NOW_PLAYING_KEY);
        if (!raw) { wrap.style.display = 'none'; return; }
        const { track: t, at } = JSON.parse(raw);
        if (!t || Date.now() - at > STALE_MS) { wrap.style.display = 'none'; return; }
        track.textContent = `${t.title || 'Unknown'}${t.artist ? ' · ' + t.artist : ''}`;
        wrap.style.display = 'flex';
      } catch { wrap.style.display = 'none'; }
    }

    refresh();
    window.addEventListener('storage', (e) => { if (e.key === NOW_PLAYING_KEY) refresh(); });

    const w = window as any;
    if (w.__archieNowPlayingTimer) clearInterval(w.__archieNowPlayingTimer);
    w.__archieNowPlayingTimer = setInterval(refresh, 4000);
  });
</script>

<style>
  .about-section { display:flex; flex-direction:column; gap:1rem; }
  .about-outer { margin-top:2rem; }
  .about-card {
    background:rgba(255,255,255,0.55);
    backdrop-filter:blur(22px); -webkit-backdrop-filter:blur(22px);
    border:1px solid rgba(255,255,255,0.75);
    padding:2.5rem 3.5rem; border-radius:1.75rem;
    position:relative; overflow:hidden;
    box-shadow:0 4px 24px rgba(100,149,237,0.08), 0 1px 4px rgba(0,0,0,0.04);
  }
  .about-deco {
    position:absolute; top:-40px; right:-40px;
    width:160px; height:160px;
    background:rgba(100,149,237,0.1);
    border-radius:50%; filter:blur(40px); pointer-events:none;
  }
  .about-article { position:relative; z-index:1; display:flex; flex-direction:column; gap:1.8rem; }

  .about-h1 {
    font-family:'Playfair Display',serif;
    font-size:clamp(3rem,10vw,4.5rem);
    font-weight:700; color:#6495ED;
    letter-spacing:-0.03em; margin-bottom:0.8rem;
  }
  .about-h2 {
    font-family:'Playfair Display',serif;
    font-size:1.8rem; font-weight:700;
    color:#334155; margin-bottom:1rem;
  }
  .about-body { display:flex; flex-direction:column; gap:1rem; }
  .about-body p { color:#475569; font-size:1.1rem; line-height:1.9; font-weight:300; }
  .about-body em { font-style:italic; color:#1e293b; }
  .about-body strong { font-weight:700; color:#1e293b; }
  .italic-mute { font-style:italic; color:#64748b; }

  .about-divider { width:64px; height:1px; background:rgba(148,163,184,0.35); }

  .about-quote-wrap { padding-top:1rem; }
  .about-quote {
    font-family:'Playfair Display',serif;
    font-style:italic; font-size:1.3rem;
    color:#64748b; line-height:1.7; text-align:center;
  }

  .now-playing {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
    padding: 0.9rem 1.1rem;
    background: rgba(100,149,237,0.07);
    border: 1px solid rgba(100,149,237,0.25);
    border-radius: 1rem;
  }
  .now-playing-pulse {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
    flex-shrink: 0;
  }
  .now-playing-pulse span {
    width: 3px;
    background: #6495ED;
    border-radius: 2px;
    animation: npBar 1s ease-in-out infinite;
  }
  .now-playing-pulse span:nth-child(1) { height: 6px;  animation-delay: 0s; }
  .now-playing-pulse span:nth-child(2) { height: 14px; animation-delay: 0.15s; }
  .now-playing-pulse span:nth-child(3) { height: 9px;  animation-delay: 0.3s; }
  @keyframes npBar {
    0%, 100% { transform: scaleY(0.5); }
    50%      { transform: scaleY(1); }
  }
  .now-playing-label {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6495ED;
    font-weight: 700;
  }
  .now-playing-track {
    font-size: 0.85rem;
    color: #334155;
    font-weight: 500;
    margin-top: 2px;
  }

  .enduring-label {
    text-align:center; margin-top:2rem;
    font-size:0.6rem; color:#94a3b8;
    letter-spacing:0.25em; text-transform:uppercase; opacity:0.6;
    font-family:monospace;
  }

  @media (max-width:480px) {
    .about-card { padding:2rem 1.5rem; }
    .about-h1 { font-size:clamp(2.5rem,12vw,3.5rem); }
    .about-body p { font-size:1rem; }
    .about-quote { font-size:1.1rem; }
  }
</style>
